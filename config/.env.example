# GreenRoute Environment Configuration
# Copy this to .env and fill in your actual values

# Flask Configuration
DEBUG=False
TESTING=False
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=greenroute_db
DB_USER=greenroute_user
DB_PASSWORD=greenroute_pass

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=True

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_ENABLED=True

# Depot Location (Pune, India)
DEPOT_LAT=18.5204
DEPOT_LNG=73.8567
DEPOT_ID=DEPOT

# Algorithm Weights (must sum to 1.0)
DISTANCE_WEIGHT=0.5
TIME_WEIGHT=0.3
EMISSIONS_WEIGHT=0.2

# Fill Level Thresholds (0-100%)
FILL_CRITICAL=80
FILL_WARNING=60
FILL_SKIP=30

# Forecasting Configuration
FORECAST_WINDOW_DAYS=30
FORECAST_MIN_ACCURACY=0.85

# Genetic Algorithm Configuration
GA_POPULATION_SIZE=100
GA_GENERATIONS=50
GA_MUTATION_RATE=0.1
GA_CROSSOVER_RATE=0.8

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/greenroute.log

# Data Paths
DATA_DIR=data
BACKUP_DIR=backups
MODELS_DIR=models
